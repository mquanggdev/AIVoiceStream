# ============================================
# Ocean Park Voice Agent — Environment Variables
# ============================================
# Copy file này thành .env rồi điền giá trị. KHÔNG commit .env.

# ---- OpenRouter: một key dùng cho LLM, STT, TTS, embedding ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://ocean-park-voice.local
OPENROUTER_APP_NAME=Ocean Park Voice Agent

# Model (đổi được, không cần sửa code). Danh sách: https://openrouter.ai/models
LLM_MODEL=openai/gpt-4.1-mini
LLM_TEMPERATURE=0.3
STT_MODEL=openai/whisper-large-v3-turbo
STT_LANGUAGE=vi
TTS_MODEL=elevenlabs/eleven-flash-v2.5
TTS_VOICE=sarah
# auto: Gemini TTS chỉ trả PCM (tự bọc WAV), model khác dùng mp3
TTS_FORMAT=auto
EMBEDDING_MODEL=openai/text-embedding-3-small

# Agent
AGENT_HISTORY_TURNS=12
AGENT_MAX_TOOL_ROUNDS=4

# ---- Dữ liệu ----
# demo_v3 = data demo (giả lập); đổi sang cleaned_data/v3 khi có data thật
DATASET_DIR=cleaned_data/demo_v3
AUTO_IMPORT_DATASET=true
RECORDINGS_DIR=data/recordings

# ---- Database ----
DATABASE_URL=sqlite:///./app.db
AUTO_CREATE_TABLES=true
# Docker Compose bootstrap values.
POSTGRES_DB=ocean_park
POSTGRES_USER=ocean_app
POSTGRES_PASSWORD=replace-with-a-local-only-password

# ---- Admin ----
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_EMAIL=admin@oceanpark.vn
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Quản trị Ocean Park

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
SQLALCHEMY_ECHO=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001


# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
